        "kv": 1,
        "template": "{\n  \"id\": \"6b1d2f0e-4c3a-4e8b-9a51-2d7c8e0f1a36\",\n  \"schemaVersion\": 1,\n  \"name\": \"Getting started\",\n  \"generatedAt\": \"2026-09-29T08:00:00Z\",\n  \"staleAfterSec\": 90,\n  \"tiles\": [\n    {\n      \"id\": \"t_status\",\n      \"view\": \"label\",\n      \"title\": \"Line 1\",\n      \"titleShort\": \"Line\",\n      \"status\": \"ok\",\n      \"value\": \"Running\",\n      \"subtext\": \"Simulated in Node-RED\"\n    },\n    {\n      \"id\": \"t_oee\",\n      \"view\": \"gauge\",\n      \"title\": \"OEE\",\n      \"status\": \"ok\",\n      \"value\": 82,\n      \"unit\": \"%\",\n      \"decimals\": 1,\n      \"range\": {\n        \"min\": 0,\n        \"max\": 100\n      },\n      \"target\": 85,\n      \"bands\": [\n        {\n          \"to\": 60,\n          \"status\": \"critical\"\n        },\n        {\n          \"to\": 80,\n          \"status\": \"warning\"\n        },\n        {\n          \"to\": 100,\n          \"status\": \"ok\"\n        }\n      ]\n    },\n    {\n      \"id\": \"t_temp\",\n      \"view\": \"line\",\n      \"title\": \"Oven temperature\",\n      \"titleShort\": \"Oven\",\n      \"value\": 180,\n      \"unit\": \"°C\",\n      \"decimals\": 1,\n      \"series\": [\n        {\n          \"name\": \"Oven\",\n          \"samples\": [\n            [\n              \"2026-09-29T07:59:00Z\",\n              179.5\n            ],\n            [\n              \"2026-09-29T07:59:30Z\",\n              180.2\n            ],\n            [\n              \"2026-09-29T08:00:00Z\",\n              180\n            ]\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"t_history\",\n      \"view\": \"timeline\",\n      \"title\": \"State today\",\n      \"titleShort\": \"State\",\n      \"from\": \"2026-09-29T06:00:00Z\",\n      \"to\": \"2026-09-29T08:00:00Z\",\n      \"states\": [\n        {\n          \"id\": \"run\",\n          \"label\": \"Running\",\n          \"status\": \"ok\"\n        },\n        {\n          \"id\": \"fault\",\n          \"label\": \"Fault\",\n          \"status\": \"critical\"\n        }\n      ],\n      \"lanes\": [\n        {\n          \"name\": \"Line 1\",\n          \"segments\": [\n            [\n              \"2026-09-29T06:00:00Z\",\n              \"run\"\n            ]\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "intervalSec": 30,
        "staleAfterSec": "",
        "notify": "auto",
        "windowPoints": 60,
