[
    {
        "id": "andon_ex_comment",
        "type": "comment",
        "name": "Andon: getting started",
        "info": "Open the view \"Getting started\", import the .env from the Andon configurator (https://andon.app/en/configurator) and deploy. The simulator below feeds four tiles; replace it with your own sources. msg.topic is the tile ID.",
        "x": 250,
        "y": 60,
        "wires": []
    },
    {
        "id": "andon_ex_inject",
        "type": "inject",
        "name": "every 5 s",
        "props": [],
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "x": 130,
        "y": 140,
        "wires": [
            [
                "andon_ex_sim"
            ]
        ]
    },
    {
        "id": "andon_ex_sim",
        "type": "function",
        "name": "Simulate production line",
        "func": "// Simulates a line: a status, an OEE, an oven temperature and a timeline.\n// Replace this node with your own sources (MQTT, S7, Modbus, SQL ...):\n// msg.topic is the tile ID, msg.payload the value.\nconst now = Date.now();\nconst t = now / 60000;\nlet state = context.get('state') || 'run';\nif (Math.random() < (state === 'run' ? 0.05 : 0.4)) { state = state === 'run' ? 'fault' : 'run'; }\ncontext.set('state', state);\n\nconst running = state === 'run';\nconst oee = running ? 76 + 9 * Math.sin(t / 7) + Math.random() * 2 : 55 + Math.random() * 3;\nconst temp = 180 + 4 * Math.sin(t / 3) + Math.random();\nconst iso = (ms) => new Date(ms).toISOString().replace(/\\.\\d+Z$/, 'Z');\n\nreturn [[\n    { topic: 't_status', payload: { value: running ? 'Running' : 'Fault', status: running ? 'ok' : 'critical' } },\n    { topic: 't_oee', payload: Math.round(oee * 10) / 10 },\n    { topic: 't_temp', payload: Math.round(temp * 10) / 10 },\n    { topic: 't_history', payload: { from: iso(now - 2 * 3600000), to: iso(now) } },\n    { topic: 't_history', payload: state },\n]];",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 140,
        "wires": [
            [
                "andon_ex_out"
            ]
        ]
    },
    {
        "id": "andon_ex_out",
        "type": "andon-out",
        "name": "",
        "view": "andon_ex_view",
        "x": 560,
        "y": 140,
        "wires": [
            [
                "andon_ex_debug"
            ]
        ]
    },
    {
        "id": "andon_ex_debug",
        "type": "debug",
        "name": "Upload",
